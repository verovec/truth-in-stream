CORS_ALLOWED_ORIGIN=localhost:3000
STORAGE_PUBLIC_ENDPOINT=localhost:9000
DEBUG_FACT_CHECK=false

# Template for .env (gitignored). docker-compose interpolates these into the
# service environments. Prefer `make bootstrap`, which copies this file to .env
# and fills the values that have no safe default (the operator credentials, plus
# a placeholder for the two provider keys the backend needs present to boot) -
# see the README Quick start. You can also copy it by hand, but note `make up`
# will not start until the TRANSCRIPTION_API_KEY / EMBEDDING_API_KEY keys are
# non-empty. The /api subtree is gated on the verified Keycloak identity, so the
# legacy AUTH_EMAIL / AUTH_PASSWORD_HASH / SESSION_SECRET trio is read only when
# LEGACY_PASSWORD_LOGIN=true (the retired password login, opt-in). The local dataset
# seeds fully offline from a committed embedding cache, so no real API key is
# needed to play the demo; the provider keys only matter for live work.

# AssemblyAI API key. AssemblyAI Universal-3 Pro streaming (u3-rt-pro) is the
# sole transcriber: it diarizes inline and handles both live streams and
# imported videos, which are transcribed live. Required to run any transcription;
# the demo results are precomputed fixtures, so no real key is needed to play the
# demo. The backend does need this present to boot, though, so `make bootstrap`
# writes a placeholder here on a fresh checkout - replace it with a real key for
# live work. Optional tuning: TRANSCRIPTION_MODEL (default u3-rt-pro),
# TRANSCRIPTION_MAX_SPEAKERS (non-negative integer; 0/empty lets the provider
# decide).
TRANSCRIPTION_API_KEY=

# Voyage AI API key for embeddings. NOT needed for seeding: `make seed` is
# strictly offline and never calls Voyage, so a stale value here cannot break it.
# Like the transcription key it must be present for the backend to boot, so
# `make bootstrap` writes a placeholder here on a fresh checkout; a real key is
# only needed to embed live query/segment text or to run `make refresh-embeddings`
# after editing a fixture's text (or changing EMBEDDING_MODEL).
EMBEDDING_API_KEY=

# Voyage embedding model for ingest and query - the SAME value must be used on
# both sides (different models are different vector spaces). Defaults to
# voyage-4-large (1024 dims, matching the pinned index; its batch endpoint works
# where base voyage-4's currently hangs), which the committed seed cache is keyed
# under. Leave empty to use the default. Setting another model invalidates the
# offline seed cache, so rerun `make refresh-embeddings` (needs EMBEDDING_API_KEY).
EMBEDDING_MODEL=

# Two-stage binary-quantization evidence search (VER-176). 0 (the default) keeps
# the single-stage halfvec search; a positive value enables the coarse bit-index
# stage (gathering multiplier x k candidates) plus a halfvec rerank, trading a
# smaller RAM working set for a rerank pass. Off until the corpus approaches the
# halfvec HNSW's RAM ceiling; validate recall on the real corpus before enabling.
# Note: hybrid evidence search (MATCH_HYBRID_SEARCH, on by default) runs its
# vector branch as the single-stage halfvec search, so while hybrid is on this
# BQ two-stage path is NOT in effect for evidence retrieval (curated-claims BQ is
# unaffected); the server logs a one-time warning at startup when both are set.
EVIDENCE_BQ_MULTIPLIER=

# BQ default-on decision threshold (VER-203, measure 4). The documented corpus
# size (in embedded evidence vectors) beyond which the two-stage
# binary-quantization search should be turned on to keep the HNSW index inside
# the instance RAM working set. `make pipeline-health` reads this and prints a
# warning once the embedded evidence_chunks count crosses it. Default 50000000
# (~50M vectors), derived from the VER-173 datastore benchmark's measured
# per-vector footprint - see docs/datastore-scale-benchmark.md. It only drives
# the health warning; it does not enable BQ (that is EVIDENCE_BQ_MULTIPLIER).
EVIDENCE_BQ_THRESHOLD_VECTORS=

# Near-duplicate embedding gate (VER-203, measure 2). Cosine-similarity bar the
# generic evidence worker applies at embed-write time: a fresh chunk whose
# nearest same-source neighbour is at least this similar is a redundant
# re-rendering (boilerplate, a re-crawl with a trivial diff, the same statistic
# restated), so it is stored for provenance but withheld from search (no vector,
# never in the HNSW index). Off by default (empty or 0) until the golden eval
# proves no recall loss; a sensible on value sits well above the evidence borrow
# threshold, e.g. 0.97. Range [0, 1]. Exact re-crawls are already skipped by the
# content-hash short-circuit (measure 1), which is always on and needs no config.
EVIDENCE_NEAR_DUP_SIMILARITY=

# Hybrid retrieval (VER-195). Fuse a French lexical full-text search with the
# vector search by Reciprocal Rank Fusion so exact figures, dates, and named
# entities dense embeddings blur are retrieved. On by default; set
# MATCH_HYBRID_SEARCH=false to force the pure vector search. While on, evidence
# retrieval uses the single-stage vector branch, so EVIDENCE_BQ_MULTIPLIER above
# has no effect for evidence (see its note). Optional tuning (empty uses the
# defaults):
#   MATCH_LEXICAL_TOP_K   lexical candidate pool per corpus (default 20)
#   MATCH_RRF_K           RRF smoothing constant (default 60)
MATCH_HYBRID_SEARCH=
MATCH_LEXICAL_TOP_K=
MATCH_RRF_K=

# Retrieval reranking (VER-226). Re-score the fused candidate pool with the
# Voyage rerank API so relevance, not raw cosine distance, decides which
# passages survive the final cut. On by default (vector-first defaults,
# measured +6.7 pts recall@1); MATCH_RERANK=false is the kill-switch.
# Fail-open (any rerank error
# or timeout keeps the fused order). The key falls back to EMBEDDING_API_KEY
# (same Voyage account); set RERANK_API_KEY only if the accounts differ.
# Optional tuning (empty uses the defaults):
#   MATCH_RERANK_MODEL       reranker model (default rerank-2.5)
#   MATCH_RERANK_CANDIDATES  widened candidate pool per corpus (default 20)
#   MATCH_RERANK_TIMEOUT     rerank call budget (default 800ms)
MATCH_RERANK=
MATCH_RERANK_MODEL=
MATCH_RERANK_CANDIDATES=
MATCH_RERANK_TIMEOUT=
RERANK_API_KEY=

# Recency weighting (VER-227): when set to a positive duration, a dated
# evidence passage's corroboration weight halves per half-life of age; undated
# passages are never decayed. Empty or 0 keeps scoring unchanged (the default).
MATCH_RECENCY_HALF_LIFE=

# Per-claim pipeline telemetry (VER-229). Each live decision leaves one
# analytical claim_checks row (decision path, retrieval quality, verdict,
# generative-call count, latency) written asynchronously off the hot path; a
# dropped telemetry row never costs a verdict. On by default; growth is bounded
# by TELEMETRY_SAMPLE_RATE and the telemetryretention sweep. Optional tuning
# (empty uses the defaults):
#   TELEMETRY_QUEUE_DEPTH     recorder buffer (default 256)
#   TELEMETRY_SAMPLE_RATE     fraction of rows kept, in (0, 1] (default 1)
#   TELEMETRY_FLUSH_INTERVAL  batch flush cadence (default 1s)
TELEMETRY_ENABLED=
TELEMETRY_QUEUE_DEPTH=
TELEMETRY_SAMPLE_RATE=
TELEMETRY_FLUSH_INTERVAL=

# Retrieval tuning (VER-202). The matcher's per-corpus retrieval knobs, all
# optional (empty keeps the defaults). Threshold and top-k are already per corpus
# (curated claims vs Wikipedia evidence); the ef_search knobs raise a single
# corpus's HNSW candidate list independently, 0 keeping pgvector's session
# default. Change a default only with golden-eval and latency evidence.
#   MATCH_TOP_K                     curated-claim neighbours retrieved (default 5)
#   MATCH_SCORE_THRESHOLD           curated-claim cosine floor (default 0.5)
#   MATCH_EVIDENCE_TOP_K            wiki-evidence neighbours; 0 disables evidence (default 5)
#   MATCH_EVIDENCE_SCORE_THRESHOLD  wiki-evidence cosine floor (default 0.6)
#   MATCH_MAX_RESULTS               merged results kept across both corpora (default 5)
#   MATCH_EMBED_CONCURRENCY         in-flight query-embed calls (default 4)
#   MATCH_TIMEOUT                   one segment's whole match budget (default 10s)
#   MATCH_CONFIDENCE_CLUSTER_SIZE   matches aggregated into the score (default 5)
#   MATCH_CONFIDENCE_LEAD_WEIGHT    lead-chunk corroboration weight (default 1.0)
#   MATCH_CONFIDENCE_BODY_WEIGHT    body-chunk corroboration weight (default 0.6)
#   MATCH_CLAIMS_EF_SEARCH          curated-claims HNSW ef_search, 0=session default (default 0)
#   MATCH_EVIDENCE_EF_SEARCH        wiki-evidence HNSW ef_search, 0=session default (default 0)
MATCH_TOP_K=
MATCH_SCORE_THRESHOLD=
MATCH_EVIDENCE_TOP_K=
MATCH_EVIDENCE_SCORE_THRESHOLD=
MATCH_MAX_RESULTS=
MATCH_EMBED_CONCURRENCY=
MATCH_TIMEOUT=
MATCH_CONFIDENCE_CLUSTER_SIZE=
MATCH_CONFIDENCE_LEAD_WEIGHT=
MATCH_CONFIDENCE_BODY_WEIGHT=
MATCH_CLAIMS_EF_SEARCH=
MATCH_EVIDENCE_EF_SEARCH=

# Check-worthiness precheck gate (legacy gate-and-match path; the retrieve-then-
# verify path replaces its coverage stage). All optional (empty keeps defaults).
#   PRECHECK_ENABLED                    run the gate at all (default true)
#   PRECHECK_MIN_WORDS                  drop fragments shorter than this (default 4)
#   PRECHECK_COVERAGE_THRESHOLD         curated-claims coverage floor (default 0.4)
#   PRECHECK_WIKI_COVERAGE_ENABLED      add the wiki corpus as a coverage source (default true)
#   PRECHECK_WIKI_COVERAGE_THRESHOLD    wiki coverage floor (default 0.46)
#   PRECHECK_COVERAGE_EF_SEARCH         coverage probe HNSW ef_search (default 200)
PRECHECK_ENABLED=
PRECHECK_MIN_WORDS=
PRECHECK_COVERAGE_THRESHOLD=
PRECHECK_WIKI_COVERAGE_ENABLED=
PRECHECK_WIKI_COVERAGE_THRESHOLD=
PRECHECK_COVERAGE_EF_SEARCH=

# Live analyzer scoring pool (legacy path). Concurrency is the number of verdict
# workers; queue depth is the backlog they drain before a unit sheds to
# not_checked. Empty keeps the defaults.
#   LIVE_CONCURRENCY   in-flight unit analyses (default 4)
#   LIVE_QUEUE_DEPTH   ready-unit backlog before shedding (default 32)
LIVE_CONCURRENCY=
LIVE_QUEUE_DEPTH=

# LLM provider selection (shared by every LLM-backed stage: the consistency
# stance check, the check-worthiness gate, claim decomposition, claim typing, the
# credibility verifier, and the ingestion fact-checkability gate). Defaults to
# "deepseek", which runs every stage on DeepSeek's cheap chat model over its
# OpenAI-compatible API using DEEPSEEK_API_KEY; set LLM_PROVIDER=anthropic to keep
# Claude Haiku, or LLM_PROVIDER=gemini to route the same forced-tool/structured
# calls to Google Gemini using GEMINI_API_KEY. An unknown value fails fast at
# startup. The per-stage *_MODEL and Anthropic per-stage *_API_KEY vars still
# apply; only the provider and the Gemini/DeepSeek keys are global. GEMINI_API_KEY
# and DEEPSEEK_API_KEY are secrets and are never logged.
#   LLM_PROVIDER      deepseek (default), anthropic, or gemini
#   DEEPSEEK_API_KEY  DeepSeek API key, required when LLM_PROVIDER is deepseek (or unset)
#   GEMINI_API_KEY    Google Gemini API key, required when LLM_PROVIDER=gemini
LLM_PROVIDER=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Live intra-speaker consistency: flag when a speaker contradicts a checkable
# statement they made earlier in the same session. OFF by default - with no key
# set, live analysis behaves exactly as before (no flags, no errors). To enable,
# set CONSISTENCY_ENABLED=true and provide an Anthropic API key. A small fast
# model judges each candidate pair; cost is bounded to at most CONSISTENCY_TOP_K
# stance calls per checkable statement. All tuning is optional (defaults shown):
#   CONSISTENCY_ENABLED            true to turn the feature on (default false)
#   CONSISTENCY_MODEL             Anthropic model (default claude-haiku-4-5-20251001)
#   CONSISTENCY_TOP_K             max stance calls per statement (default 3)
#   CONSISTENCY_SIMILARITY_FLOOR  cosine floor gating the stance check (default 0.6)
CONSISTENCY_ENABLED=
CONSISTENCY_API_KEY=

# Model check-worthiness classifier: upgrade the precheck gate's first stage so
# casual or personal declaratives ("I had coffee this morning") are skipped, not
# fact-checked. ON by default (vector-first defaults, VER-230) but inactive
# until a key is set - with no key, the deterministic heuristic
# alone decides claim-worthiness, exactly as before (no model calls, no errors).
# The heuristic still runs first and rejects obvious non-claims for free; only
# its survivors reach the model, and a model outage degrades to the heuristic
# decision. To enable, set CHECKWORTHINESS_ENABLED=true and provide an Anthropic
# API key. All tuning is optional (defaults shown):
#   CHECKWORTHINESS_ENABLED  kill-switch; set false to force the heuristic alone (default true)
#   CHECKWORTHINESS_MODEL    Anthropic model (default claude-haiku-4-5-20251001)
CHECKWORTHINESS_ENABLED=
CHECKWORTHINESS_API_KEY=

# Local check-worthiness classifier (VER-225): a fine-tuned French encoder
# (CamemBERTa-v2, ONNX, CPU) scores every statement the deterministic heuristic
# lets through. Clear cases are decided locally at zero marginal cost; only
# scores inside the [BAND_LOW, BAND_HIGH) uncertainty band still reach the
# generative gate above. ON by default (vector-first defaults) but inactive
# until the artifact paths are set. Requires a binary built with the
# `localinference` build tag plus the exported model and tokenizer artifacts
# (stack/ml/checkworthy trains and exports them; they are distributed outside
# git). Any load failure degrades to the heuristic-plus-model cascade at boot.
#   CHECKWORTHINESS_LOCAL_ENABLED        kill-switch; set false to skip the local scorer (default true)
#   CHECKWORTHINESS_LOCAL_MODEL_PATH     exported ONNX classifier (e.g. /models/checkworthy.int8.onnx)
#   CHECKWORTHINESS_LOCAL_TOKENIZER_PATH matching tokenizer.json
#   CHECKWORTHINESS_LOCAL_ONNX_LIBRARY   ONNX Runtime shared library path (optional; loader default otherwise)
#   CHECKWORTHINESS_LOCAL_BAND_LOW       reject below this calibrated probability (default 0.35)
#   CHECKWORTHINESS_LOCAL_BAND_HIGH      accept at or above this probability (default 0.75)
#   CHECKWORTHINESS_LOCAL_TIMEOUT        per-statement inference budget (default 300ms)
CHECKWORTHINESS_LOCAL_ENABLED=
CHECKWORTHINESS_LOCAL_MODEL_PATH=
CHECKWORTHINESS_LOCAL_TOKENIZER_PATH=
CHECKWORTHINESS_LOCAL_ONNX_LIBRARY=

# Local NLI stance stage (VER-228): a French cross-encoder
# (camembertav2-base-xnli, community ONNX export, CPU) scores each retrieved
# passage's stance toward the claim. Clear support or contradiction decides
# the verdict locally with citations and no generative call; mixed, neutral,
# or under-threshold evidence escalates to the LLM verifier unchanged. OFF by
# default. Requires a binary built with the `localinference` build tag plus
# the model and tokenizer artifacts (stack/ml/checkworthy nli-fetch downloads
# them; distributed outside git). Any load failure degrades to the LLM-first
# verify path at boot. Defaults come from the recorded calibration run.
#   FACTCHECK_NLI_ENABLED               kill-switch; set false to skip the stance stage (default true)
#   FACTCHECK_NLI_MODEL_PATH            NLI ONNX graph (e.g. /models/nli.int8.onnx)
#   FACTCHECK_NLI_TOKENIZER_PATH        matching tokenizer.json
#   FACTCHECK_NLI_ONNX_LIBRARY          ONNX Runtime shared library (falls back to CHECKWORTHINESS_LOCAL_ONNX_LIBRARY)
#   FACTCHECK_NLI_TEMPERATURE           calibration temperature (default 1.8634)
#   FACTCHECK_NLI_ENTAIL_THRESHOLD      support decision bar (default 0.70)
#   FACTCHECK_NLI_CONTRADICT_THRESHOLD  refute decision bar (default 0.90, deliberately stricter)
#   FACTCHECK_NLI_MIN_AGREE             agreeing passages required (default 1)
#   FACTCHECK_NLI_MAX_PASSAGES          passages cross-encoded per claim (default 6)
#   FACTCHECK_NLI_TIMEOUT               per-claim stance budget (default 2s)
FACTCHECK_NLI_ENABLED=
FACTCHECK_NLI_MODEL_PATH=
FACTCHECK_NLI_TOKENIZER_PATH=
FACTCHECK_NLI_ONNX_LIBRARY=

# Retrieve-then-verify fact-check path: instead of borrowing a verdict from the
# nearest curated claim by similarity (the legacy gate-and-match path, which
# returns "no confident match" when nothing clears the borrow threshold), this
# path decomposes each unit into atomic claims, retrieves evidence, and has an
# LLM verifier derive the verdict (supports/refutes/not_enough_info) from that
# evidence. ON by default (vector-first defaults) but inactive until a key is
# provided; with no key it stays on the legacy path. Provide
# an Anthropic API key; with no key it stays on the legacy path. The flag is read
# at startup, so recreate the backend after changing it. All tuning is optional
# (defaults shown):
#   FACTCHECK_VERIFY_PATH                 kill-switch; set false to force the legacy gate-and-match path (default true)
#   FACTCHECK_VERIFY_MODEL                decomposer + verifier model (default claude-haiku-4-5-20251001)
#   FACTCHECK_VERIFY_MAX_CLAIMS_PER_UNIT  cap on atomic claims per unit (default 4)
#   FACTCHECK_VERIFY_FAST_TAU             curated near-match borrow threshold (default 0.85)
#   FACTCHECK_VERIFY_RETRIEVAL_THRESHOLD  recall floor for evidence fed to the verifier
#                                         (default 0.45). Lower than the legacy 0.6 borrow
#                                         threshold on purpose: the verifier wants recall, so
#                                         the on-topic band (~0.51-0.65) is retrieved and judged
#                                         rather than discarded into a no-evidence not_enough_info.
#   FACTCHECK_VERIFY_CONCURRENCY          in-flight verify calls (default 2)
#   FACTCHECK_VERIFY_QUEUE_DEPTH          claims queued for a verify slot (default 4)
#   FACTCHECK_VERIFY_FAST_DEADLINE        decompose+retrieve bound (default 800ms)
#   FACTCHECK_VERIFY_DEADLINE             one verify call bound (default 4s)
#   FACTCHECK_VERIFY_CACHE_TTL            semantic-claim-cache window, 0 disables (default 30s)
#   FACTCHECK_VERIFY_CACHE_THRESHOLD      cosine bar for a cache hit; a paraphrase above it
#                                         replays the cached verdict with no verifier call
#                                         (default 0.95, high = precision over recall)
#   FACTCHECK_VERIFY_CACHE_MAX_ENTRIES    in-process cache size, oldest evicted first (default 1024)
FACTCHECK_VERIFY_PATH=
FACTCHECK_VERIFY_API_KEY=

# Terminal reasoning gate for weak verdicts (VER-192). OFF by default. When the verify
# path's best verdict for a claim is weak - unverifiable, or confidence below the
# trigger floor - a stronger reasoning model re-judges the SAME retrieved evidence one
# last time; it upgrades the verdict in place only when its re-judgment is grounded AND
# reaches the min-confidence floor, otherwise the honest weak verdict stands (an
# unverifiable prior stays unverifiable). It runs off the live hot path (after the fast
# verdict is emitted, outside the verify pool, bounded by its own deadline) and applies
# to BOTH the credibility-only path and the political two-axis path. The gate layers
# over the second pass: every knob falls back to its FACTCHECK_SECOND_PASS_* equivalent,
# and the FACTCHECK_FINAL_GATE_* knobs override piece by piece - so an operator who only
# set FACTCHECK_SECOND_PASS keeps a working gate. Its provider is decoupled from the
# shared LLM_PROVIDER, so the costly reasoner can run on a different backend than the hot
# path. To enable, set FACTCHECK_SECOND_PASS=true (or FACTCHECK_FINAL_GATE=true) and
# provide the reasoner's key (the selected provider's key, or FACTCHECK_FINAL_GATE_API_KEY /
# FACTCHECK_SECOND_PASS_API_KEY under Anthropic); with no key it degrades to the
# single-pass verify path. Read at startup; recreate the backend after changing it.
#   FACTCHECK_SECOND_PASS               true to turn the reasoner on (default false)
#   FACTCHECK_FINAL_GATE                gate enable override (default: follows FACTCHECK_SECOND_PASS)
#   FACTCHECK_FINAL_GATE_PROVIDER       decoupled provider override (default: LLM_PROVIDER)
#   FACTCHECK_FINAL_GATE_API_KEY        Anthropic key override (default FACTCHECK_SECOND_PASS_API_KEY)
#   FACTCHECK_FINAL_GATE_MODEL          reasoning model (default: the second pass's model)
#   FACTCHECK_FINAL_GATE_TRIGGER_BELOW  escalate a verdict below this confidence (default: second-pass band high, 0.8)
#   FACTCHECK_FINAL_GATE_MIN_CONFIDENCE grounded confidence to adopt the re-judgment (default 0.90)
#   FACTCHECK_FINAL_GATE_DEADLINE       one reverify call bound (default: second-pass deadline, 12s)
FACTCHECK_SECOND_PASS=
FACTCHECK_SECOND_PASS_API_KEY=
FACTCHECK_FINAL_GATE=
FACTCHECK_FINAL_GATE_API_KEY=

# French/EU political fact-checking mode. ON by default (vector-first defaults):
# the default deployment runs the French political pipeline. Set false so the stack keeps its
# English behavior. When true, live transcription biases toward French
# (language_code=fr, speaker labels on) and the live LLM stages (check-worthiness
# gate, claim decomposition) prompt and reason in French; when false the stages
# run in English exactly as before. When it is on AND the verify path is active
# (FACTCHECK_VERIFY_PATH + key above), the per-claim verify stage becomes the
# political pipeline: classify -> route to authoritative sources (stats / voting /
# press) + web-search fallback -> two-axis verify (literal verdict + manipulation
# flags) -> flag-aware per-speaker score. With it off, the verify path runs its
# credibility-only stage unchanged. Read at startup, so recreate the backend after
# changing it.
#   FACTCHECK_POLITICAL                      kill-switch; set false for the English legacy stages (default true)
#   FACTCHECK_POLITICAL_ROUTER_MIN_RESULTS   thin-result floor before broadening to web search (default 1)
#   FACTCHECK_POLITICAL_CURATED_TAU          cosine bar to borrow a curated two-axis claim
#                                            (literal verdict + flags + real source) with no LLM
#                                            call (default 0.85)
FACTCHECK_POLITICAL=
FACTCHECK_POLITICAL_ROUTER_MIN_RESULTS=
FACTCHECK_POLITICAL_CURATED_TAU=
# Curated fast-borrow age guard (VER-227): a curated verdict checked longer ago
# than this duration is not borrowed; the claim runs the normal verify path.
# Empty or 0 disables the guard (current behavior). Example: 8760h (one year).
FACTCHECK_POLITICAL_CURATED_MAX_AGE=

# Political source packs, read only when FACTCHECK_POLITICAL is on (default on
# since VER-230). Every pack is optional: web search is the open-ended fallback
# claims fall through to and the press pack answers attributions, but each joins
# only when its own key is set, and the stats pack is keyless (optional
# timeout/cache tuning only). With no WEBSEARCH_API_KEY the backend still starts
# and logs a warning: statistic and voting-record claims are answered from the
# keyless packs, while open-ended claims retrieve no evidence and are reported as
# unverified. Get a key at https://brave.com/search/api/ on the Search plan (the
# pack calls /res/v1/web/search); the $5 of monthly free credits covers local
# development. Secrets are read from the environment only and never logged.
#   WEBSEARCH_API_KEY                        Brave token for the web-search fallback (optional; unset degrades)
#   WEBSEARCH_TIMEOUT                        optional per-request timeout (e.g. 5s)
#   PRESS_API_KEY                            Brave token for the press/attribution pack (optional)
#   PRESS_TIMEOUT                            optional per-request timeout (e.g. 5s)
#   STATS_TIMEOUT / STATS_CACHE_TTL          optional stats-pack tuning (keyless endpoints)
WEBSEARCH_API_KEY=
WEBSEARCH_TIMEOUT=
PRESS_API_KEY=
PRESS_TIMEOUT=
STATS_TIMEOUT=
STATS_CACHE_TTL=

# Analysis cache (Redis/Valkey). Caches a completed imported video's analysis so it
# can be replayed instantly without re-running the live pipeline. Optional: leave
# REDIS_URL empty to disable caching entirely - the backend then behaves exactly as
# it does today. When set, the backend pings it at startup and falls back to the
# no-op cache if it is unreachable, so a missing or down cache never blocks boot.
# Compose runs a local redis service and wires REDIS_URL to it automatically; set a
# value here only to point at an external cache. REDIS_URL can carry a password, so
# it is a secret and is never logged. ANALYSIS_CACHE_TTL bounds how long a cached
# analysis lives (default 24h).
#   REDIS_URL            redis:// or rediss:// connection string (empty disables caching)
#   ANALYSIS_CACHE_TTL   cached-analysis lifetime (default 24h)
REDIS_URL=
ANALYSIS_CACHE_TTL=

# Wikipedia bulk-embed tuning for `make wiki-populate` / `make wiki-update`.
# All optional - leave empty to use the gentle defaults shown, which suit a
# constrained Voyage tier. Compose reads these from here automatically (a shell
# value still overrides). Raise the batch and concurrency on a higher tier.
#   WIKI_CORPUS             which Wikipedia to ingest (default simplewiki)
#   WIKI_MAX_DURATION       0 runs to completion; set e.g. 15m to box a session
#   WIKI_EMBED_BATCH_SIZE   chunks per Voyage request (default 32)
#   WIKI_EMBED_CONCURRENCY  parallel embed requests (default 2)
#   WIKI_EMBED_HTTP_TIMEOUT per-request timeout (default 300s)
#   WIKI_EMBED_RPM          cap on requests/min, 0 = unpaced (default 0)
WIKI_CORPUS=
WIKI_MAX_DURATION=
WIKI_EMBED_BATCH_SIZE=
WIKI_EMBED_CONCURRENCY=
WIKI_EMBED_HTTP_TIMEOUT=
WIKI_EMBED_RPM=

# RabbitMQ embedding-job queue. The compose `rabbitmq` service is reachable at
# amqp://app:dev@rabbitmq:5672/ from the other containers (its credentials are
# fixed in docker-compose.yml); the management UI is on http://localhost:15672.
# Nothing consumes the queue yet, so these are unset by default; the embedding
# producer and worker services read them once they ship. All optional:
#   RABBITMQ_URL              broker connection string (carries the credentials)
#   RABBITMQ_QUEUE            base queue name (default embedding.jobs)
#   RABBITMQ_QUEUE_VERSIONS   comma-separated, oldest-first version list (default 1).
#                             Each version is a queue-name suffix: the queue is
#                             named <queue>.v<version> and the newest is active.
#   RABBITMQ_MAX_PRIORITY     x-max-priority ceiling, 1-255 (default 10)
#   RABBITMQ_PREFETCH         per-consumer unacked limit, 0 = unbounded (default 1)
#   RABBITMQ_DLQ_ENABLED      route rejected messages to a companion <queue>.dlq.v<n>
#                             dead-letter queue instead of discarding them (default
#                             true). Must be identical on producers and consumers or
#                             their queue declarations conflict.
#   RABBITMQ_RECONNECT_MIN_BACKOFF  first redial wait after a broker drop (default 250ms)
#   RABBITMQ_RECONNECT_MAX_BACKOFF  redial wait ceiling; must be >= the min (default 30s)
RABBITMQ_URL=

# Fact-check-archive crawler (`make factcheck-crawl`): ingests already-checked
# French claims from the Google Fact Check Tools API (the standardized
# ClaimReview aggregator for Les Decodeurs, AFP Factuel, franceinfo Vrai ou Fake)
# into the curated political claim DB, embedded for the fast-path matcher.
# Reading the API rather than scraping article HTML keeps ingestion within each
# outlet's terms of service. Producer publishes self-contained jobs to its own
# queue (RABBITMQ_FACTCHECK_QUEUE, default factcheck.claims); the factcheckworker
# fleet embeds and upserts them. Required for a run:
#   FACTCHECK_API_KEY     Google Fact Check Tools API key (never logged)
#   FACTCHECK_QUERIES     comma-separated claims:search terms to walk
# Optional:
#   FACTCHECK_LANGUAGE    claim language filter (default fr)
#   FACTCHECK_MAX_PAGES   per-query result-page cap (0/empty = follow every page)
FACTCHECK_API_KEY=
FACTCHECK_QUERIES=

# Scrutins-archive crawler (`make scrutins-crawl`): conditionally downloads the
# Assemblee Nationale open-data Scrutins.json.zip bulk archive (Etalab Licence
# Ouverte 2.0, attribution "Assemblee nationale - data.assemblee-nationale.fr";
# programmatic bulk download is permitted), discovers each recorded scrutin, and
# publishes one self-contained job to its own queue (RABBITMQ_SCRUTINS_QUEUE,
# default scrutins.votes); the scrutinsworker fleet parses and upserts them into
# the voting store. A persisted ETag/Last-Modified marker makes the download a
# conditional GET, so an unchanged archive returns 304 and the run does no
# redundant work. No API key (public open data). All optional (defaults shown):
#   SCRUTINS_LEGISLATURE       AN legislature number, interpolated into the URL (default 17)
#   SCRUTINS_MARKER_PATH       where the conditional-GET marker persists between runs
#                              (default /state/scrutins-marker.json; empty disables the skip)
#   SCRUTINS_WORKER_CONCURRENCY  scrutins parsed/upserted in parallel per replica (default 4)
#   SCRUTINS_WORKER_MAX_ATTEMPTS per-job delivery budget before a drop (default 5)
SCRUTINS_LEGISLATURE=
SCRUTINS_MARKER_PATH=

# Ingestion-fleet scheduler (the always-on `scheduler` compose service). Runs each
# enabled source's producer on its own cron cadence with no manual command - the
# Wikipedia, fact-check-archive, and scrutins crawls publish into their queues for
# the worker fleet to drain, an overlapping tick of a source whose previous run is
# still in flight is skipped, and every run posts the standard start/finish/failure
# Slack alerts (SLACK_WEBHOOK_URL below). Each source reads the same producer config
# its standalone crawler does (CRAWL_*, FACTCHECK_*, SCRUTINS_* above), so an enabled
# source needs those set. Every source defaults DISABLED so a plain `docker compose
# up` runs an idle scheduler and never starts paid ingestion - opt a source in with
# its *_ENABLED=true. All optional (defaults shown); a malformed cron spec fails the
# scheduler fast at startup:
#   SCHEDULE_WIKIPEDIA_ENABLED   run the Wikipedia crawl on a schedule (default false)
#   SCHEDULE_WIKIPEDIA_CRON      its 5-field cron spec (default "0 3 * * *", 03:00 daily)
#   SCHEDULE_FACTCHECK_ENABLED   run the fact-check-archive crawl (default false)
#   SCHEDULE_FACTCHECK_CRON      its cron spec (default "0 4 * * *", 04:00 daily)
#   SCHEDULE_SCRUTINS_ENABLED    run the scrutins crawl (default false)
#   SCHEDULE_SCRUTINS_CRON       its cron spec (default "30 4 * * *", 04:30 daily)
#   SCHEDULE_JITTER              random per-run delay spreading concurrent sources,
#                                Go duration, capped at 1h (default 30s)
SCHEDULE_WIKIPEDIA_ENABLED=
SCHEDULE_WIKIPEDIA_CRON=
SCHEDULE_FACTCHECK_ENABLED=
SCHEDULE_FACTCHECK_CRON=
SCHEDULE_SCRUTINS_ENABLED=
SCHEDULE_SCRUTINS_CRON=
SCHEDULE_JITTER=

# Media bytes for the curated sample video gallery (`make seed` / `make
# seed-videos`). Empty falls back to a public test clip (BigBuckBunny). The
# clip is fetched once and cached under stack/backend/seed/media-cache/
# (gitignored, reused across reseeds); an unreachable host with no cache seeds
# the sample records without media instead of failing. Sample videos stream
# live through the AssemblyAI pipeline when played, so any clip produces
# fact-checks; set this to a clip whose claims overlap the seeded corpus for
# the most interesting verdicts.
SAMPLE_VIDEO_URL=

# Legacy operator login (retired by default). The /api subtree is gated on the
# verified Keycloak identity; this password-session login is wired only when
# LEGACY_PASSWORD_LOGIN=true, for an environment that has no Keycloak yet. The
# three values below are then read; off (the default) they are ignored. `make
# bootstrap` still fills them for you so opting back in needs no extra step.
# LEGACY_PASSWORD_LOGIN=false

# Operator login email.
AUTH_EMAIL=

# Encoded argon2id hash of the operator password - never the password itself.
# Generate it with: printf '%s' "your-password" | go run ./cmd/genhash
# (run from stack/backend). Single-quote the value so the $ signs in the hash
# are not expanded by docker-compose:
# AUTH_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$...'
AUTH_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$shBQcmQC9qrZBGi0S55dZw$8FQY60gGln/W4hIs42tz7yeJ2WEzZFNOCbIlhNdx0k4'

# Session-signing secret, at least 32 bytes.
# Generate it with: openssl rand -hex 32
# Rotating it (plus a backend restart) invalidates every outstanding session.
SESSION_SECRET=

# Slack incoming-webhook URL for the daily development digest (`make digest`).
# Provisioned secret; treat it as one. Absent -> `make digest` errors; the
# terminal report (`/report` / `--terminal`) and `--dry-run` work without it.
SLACK_DIGEST_WEBHOOK_URL=

# Slack incoming-webhook URL for ingestion-fleet run alerts (crawl start, finish
# summary, and failures). Provisioned secret; treat it as one. Absent -> the
# crawl notifier is a silent no-op, so local ingestion runs are unaffected.
SLACK_WEBHOOK_URL=

# Linear personal API key. Enables the digest's Linear activity and blocker
# sections; absent -> those sections show a note. Read-only usage.
LINEAR_API_KEY=

# GitHub token for the digest's open-PR section. Optional: the public repo works
# without it, but a token raises the rate limit.
GITHUB_TOKEN=

# API key for the digest's per-card "what was implemented" summaries. Honors the
# global LLM_PROVIDER: under the default (deepseek) the key is DEEPSEEK_API_KEY;
# under LLM_PROVIDER=gemini it is GEMINI_API_KEY; under LLM_PROVIDER=anthropic it
# is this var. Optional either way: absent -> shipped cards fall back to their
# Linear titles, so the digest still works fully. DIGEST_SUMMARY_MODEL overrides
# the model (the selected provider's default otherwise).
DIGEST_SUMMARY_API_KEY=
DIGEST_SUMMARY_MODEL=
