CORS_ALLOWED_ORIGIN=localhost:3000
STORAGE_PUBLIC_ENDPOINT=localhost:9000
DEBUG_FACT_CHECK=false

# Template for .env (gitignored). docker-compose interpolates these into the
# service environments. Prefer `make bootstrap`, which copies this file to .env
# and fills the values that have no safe default (the operator credentials, plus
# a placeholder for the two provider keys the backend needs present to boot) -
# see the README Quick start. You can also copy it by hand, but note `make up`
# will not start until AUTH_EMAIL / AUTH_PASSWORD_HASH / SESSION_SECRET and the
# TRANSCRIPTION_API_KEY / EMBEDDING_API_KEY keys are non-empty. The local dataset
# seeds fully offline from a committed embedding cache, so no real API key is
# needed to play the demo; the provider keys only matter for live work.

# AssemblyAI API key. AssemblyAI Universal-3 Pro streaming (u3-rt-pro) is the
# sole transcriber: it diarizes inline and handles both live streams and
# imported videos, which are transcribed live. Required to run any transcription;
# the demo results are precomputed fixtures, so no real key is needed to play the
# demo. The backend does need this present to boot, though, so `make bootstrap`
# writes a placeholder here on a fresh checkout - replace it with a real key for
# live work. Optional tuning: TRANSCRIPTION_MODEL (default u3-rt-pro),
# TRANSCRIPTION_MAX_SPEAKERS (non-negative integer; 0/empty lets the provider
# decide).
TRANSCRIPTION_API_KEY=

# Voyage AI API key for embeddings. NOT needed for seeding: `make seed` is
# strictly offline and never calls Voyage, so a stale value here cannot break it.
# Like the transcription key it must be present for the backend to boot, so
# `make bootstrap` writes a placeholder here on a fresh checkout; a real key is
# only needed to embed live query/segment text or to run `make refresh-embeddings`
# after editing a fixture's text (or changing EMBEDDING_MODEL).
EMBEDDING_API_KEY=

# Voyage embedding model for ingest and query - the SAME value must be used on
# both sides (different models are different vector spaces). Defaults to
# voyage-4-large (1024 dims, matching the pinned index; its batch endpoint works
# where base voyage-4's currently hangs), which the committed seed cache is keyed
# under. Leave empty to use the default. Setting another model invalidates the
# offline seed cache, so rerun `make refresh-embeddings` (needs EMBEDDING_API_KEY).
EMBEDDING_MODEL=

# LLM provider selection (shared by every LLM-backed stage: the consistency
# stance check, the check-worthiness gate, claim decomposition, claim typing, the
# credibility verifier, and the ingestion fact-checkability gate). Defaults to
# "deepseek", which runs every stage on DeepSeek's cheap chat model over its
# OpenAI-compatible API using DEEPSEEK_API_KEY; set LLM_PROVIDER=anthropic to keep
# Claude Haiku, or LLM_PROVIDER=gemini to route the same forced-tool/structured
# calls to Google Gemini using GEMINI_API_KEY. An unknown value fails fast at
# startup. The per-stage *_MODEL and Anthropic per-stage *_API_KEY vars still
# apply; only the provider and the Gemini/DeepSeek keys are global. GEMINI_API_KEY
# and DEEPSEEK_API_KEY are secrets and are never logged.
#   LLM_PROVIDER      deepseek (default), anthropic, or gemini
#   DEEPSEEK_API_KEY  DeepSeek API key, required when LLM_PROVIDER is deepseek (or unset)
#   GEMINI_API_KEY    Google Gemini API key, required when LLM_PROVIDER=gemini
LLM_PROVIDER=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Live intra-speaker consistency: flag when a speaker contradicts a checkable
# statement they made earlier in the same session. OFF by default - with no key
# set, live analysis behaves exactly as before (no flags, no errors). To enable,
# set CONSISTENCY_ENABLED=true and provide an Anthropic API key. A small fast
# model judges each candidate pair; cost is bounded to at most CONSISTENCY_TOP_K
# stance calls per checkable statement. All tuning is optional (defaults shown):
#   CONSISTENCY_ENABLED            true to turn the feature on (default false)
#   CONSISTENCY_MODEL             Anthropic model (default claude-haiku-4-5-20251001)
#   CONSISTENCY_TOP_K             max stance calls per statement (default 3)
#   CONSISTENCY_SIMILARITY_FLOOR  cosine floor gating the stance check (default 0.6)
CONSISTENCY_ENABLED=
CONSISTENCY_API_KEY=

# Model check-worthiness classifier: upgrade the precheck gate's first stage so
# casual or personal declaratives ("I had coffee this morning") are skipped, not
# fact-checked. OFF by default - with no key set, the deterministic heuristic
# alone decides claim-worthiness, exactly as before (no model calls, no errors).
# The heuristic still runs first and rejects obvious non-claims for free; only
# its survivors reach the model, and a model outage degrades to the heuristic
# decision. To enable, set CHECKWORTHINESS_ENABLED=true and provide an Anthropic
# API key. All tuning is optional (defaults shown):
#   CHECKWORTHINESS_ENABLED  true to turn the model stage on (default false)
#   CHECKWORTHINESS_MODEL    Anthropic model (default claude-haiku-4-5-20251001)
CHECKWORTHINESS_ENABLED=
CHECKWORTHINESS_API_KEY=

# Retrieve-then-verify fact-check path: instead of borrowing a verdict from the
# nearest curated claim by similarity (the legacy gate-and-match path, which
# returns "no confident match" when nothing clears the borrow threshold), this
# path decomposes each unit into atomic claims, retrieves evidence, and has an
# LLM verifier derive the verdict (supports/refutes/not_enough_info) from that
# evidence. OFF by default. To enable, set FACTCHECK_VERIFY_PATH=true and provide
# an Anthropic API key; with no key it stays on the legacy path. The flag is read
# at startup, so recreate the backend after changing it. All tuning is optional
# (defaults shown):
#   FACTCHECK_VERIFY_PATH                 true to turn the path on (default false)
#   FACTCHECK_VERIFY_MODEL                decomposer + verifier model (default claude-haiku-4-5-20251001)
#   FACTCHECK_VERIFY_MAX_CLAIMS_PER_UNIT  cap on atomic claims per unit (default 4)
#   FACTCHECK_VERIFY_FAST_TAU             curated near-match borrow threshold (default 0.85)
#   FACTCHECK_VERIFY_RETRIEVAL_THRESHOLD  recall floor for evidence fed to the verifier
#                                         (default 0.45). Lower than the legacy 0.6 borrow
#                                         threshold on purpose: the verifier wants recall, so
#                                         the on-topic band (~0.51-0.65) is retrieved and judged
#                                         rather than discarded into a no-evidence not_enough_info.
#   FACTCHECK_VERIFY_CONCURRENCY          in-flight verify calls (default 2)
#   FACTCHECK_VERIFY_QUEUE_DEPTH          claims queued for a verify slot (default 4)
#   FACTCHECK_VERIFY_FAST_DEADLINE        decompose+retrieve bound (default 800ms)
#   FACTCHECK_VERIFY_DEADLINE             one verify call bound (default 4s)
#   FACTCHECK_VERIFY_CACHE_TTL            repeated-claim cache window, 0 disables (default 30s)
FACTCHECK_VERIFY_PATH=
FACTCHECK_VERIFY_API_KEY=

# Deeper-reasoner second pass for grounded mid-confidence verdicts. OFF by default.
# When the verify path returns an evidence-grounded verdict whose confidence sits in
# a configurable mid band, a stronger reasoning model re-judges the same evidence and
# may upgrade the verdict in place. It runs off the live hot path (after the fast
# verdict is emitted, outside the verify pool, bounded by its own deadline) and never
# lifts a knowledge-only verdict past the confidence cap. Only the credibility-only
# verify stage runs it; political mode owns its own verify stage. To enable, set
# FACTCHECK_SECOND_PASS=true and provide the reasoner's key (the selected provider's
# key, or FACTCHECK_SECOND_PASS_API_KEY under Anthropic); with no key it degrades to
# the single-pass verify path. Read at startup; recreate the backend after changing it.
#   FACTCHECK_SECOND_PASS            true to turn the second pass on (default false)
#   FACTCHECK_SECOND_PASS_MODEL      reasoning model (default deepseek-v4-pro under DeepSeek -
#                                    the larger, materially costlier reasoning tier)
#   FACTCHECK_SECOND_PASS_BAND_LO    qualifying confidence band low edge, inclusive (default 0.45)
#   FACTCHECK_SECOND_PASS_BAND_HI    qualifying confidence band high edge, inclusive (default 0.8)
#   FACTCHECK_SECOND_PASS_DEADLINE   one reverify call bound (default 12s)
FACTCHECK_SECOND_PASS=
FACTCHECK_SECOND_PASS_API_KEY=

# French/EU political fact-checking mode. OFF by default so the stack keeps its
# English behavior. When true, live transcription biases toward French
# (language_code=fr, speaker labels on) and the live LLM stages (check-worthiness
# gate, claim decomposition) prompt and reason in French; when false the stages
# run in English exactly as before. When it is on AND the verify path is active
# (FACTCHECK_VERIFY_PATH + key above), the per-claim verify stage becomes the
# political pipeline: classify -> route to authoritative sources (stats / voting /
# press) + web-search fallback -> two-axis verify (literal verdict + manipulation
# flags) -> flag-aware per-speaker score. With it off, the verify path runs its
# credibility-only stage unchanged. Read at startup, so recreate the backend after
# changing it.
#   FACTCHECK_POLITICAL                      true to switch the live stages to French (default false)
#   FACTCHECK_POLITICAL_ROUTER_MIN_RESULTS   thin-result floor before broadening to web search (default 1)
FACTCHECK_POLITICAL=
FACTCHECK_POLITICAL_ROUTER_MIN_RESULTS=

# Political source packs, read only when FACTCHECK_POLITICAL is on. Web search is
# the mandatory open-ended fallback every claim falls through to, so its key is
# required in political mode; the press pack joins only when its own key is set;
# the stats pack is keyless (optional timeout/cache tuning only). Secrets are read
# from the environment only and never logged.
#   WEBSEARCH_API_KEY                        Brave token for the web-search fallback (required in political mode)
#   WEBSEARCH_TIMEOUT                        optional per-request timeout (e.g. 5s)
#   PRESS_API_KEY                            Brave token for the press/attribution pack (optional)
#   PRESS_TIMEOUT                            optional per-request timeout (e.g. 5s)
#   STATS_TIMEOUT / STATS_CACHE_TTL          optional stats-pack tuning (keyless endpoints)
WEBSEARCH_API_KEY=
WEBSEARCH_TIMEOUT=
PRESS_API_KEY=
PRESS_TIMEOUT=
STATS_TIMEOUT=
STATS_CACHE_TTL=

# Wikipedia bulk-embed tuning for `make wiki-populate` / `make wiki-update`.
# All optional - leave empty to use the gentle defaults shown, which suit a
# constrained Voyage tier. Compose reads these from here automatically (a shell
# value still overrides). Raise the batch and concurrency on a higher tier.
#   WIKI_CORPUS             which Wikipedia to ingest (default simplewiki)
#   WIKI_MAX_DURATION       0 runs to completion; set e.g. 15m to box a session
#   WIKI_EMBED_BATCH_SIZE   chunks per Voyage request (default 32)
#   WIKI_EMBED_CONCURRENCY  parallel embed requests (default 2)
#   WIKI_EMBED_HTTP_TIMEOUT per-request timeout (default 300s)
#   WIKI_EMBED_RPM          cap on requests/min, 0 = unpaced (default 0)
WIKI_CORPUS=
WIKI_MAX_DURATION=
WIKI_EMBED_BATCH_SIZE=
WIKI_EMBED_CONCURRENCY=
WIKI_EMBED_HTTP_TIMEOUT=
WIKI_EMBED_RPM=

# RabbitMQ embedding-job queue. The compose `rabbitmq` service is reachable at
# amqp://app:dev@rabbitmq:5672/ from the other containers (its credentials are
# fixed in docker-compose.yml); the management UI is on http://localhost:15672.
# Nothing consumes the queue yet, so these are unset by default; the embedding
# producer and worker services read them once they ship. All optional:
#   RABBITMQ_URL              broker connection string (carries the credentials)
#   RABBITMQ_QUEUE            base queue name (default embedding.jobs)
#   RABBITMQ_QUEUE_VERSIONS   comma-separated, oldest-first version list (default 1).
#                             Each version is a queue-name suffix: the queue is
#                             named <queue>.v<version> and the newest is active.
#   RABBITMQ_MAX_PRIORITY     x-max-priority ceiling, 1-255 (default 10)
#   RABBITMQ_PREFETCH         per-consumer unacked limit, 0 = unbounded (default 1)
RABBITMQ_URL=

# Fact-check-archive crawler (`make factcheck-crawl`): ingests already-checked
# French claims from the Google Fact Check Tools API (the standardized
# ClaimReview aggregator for Les Decodeurs, AFP Factuel, franceinfo Vrai ou Fake)
# into the curated political claim DB, embedded for the fast-path matcher.
# Reading the API rather than scraping article HTML keeps ingestion within each
# outlet's terms of service. Producer publishes self-contained jobs to its own
# queue (RABBITMQ_FACTCHECK_QUEUE, default factcheck.claims); the factcheckworker
# fleet embeds and upserts them. Required for a run:
#   FACTCHECK_API_KEY     Google Fact Check Tools API key (never logged)
#   FACTCHECK_QUERIES     comma-separated claims:search terms to walk
# Optional:
#   FACTCHECK_LANGUAGE    claim language filter (default fr)
#   FACTCHECK_MAX_PAGES   per-query result-page cap (0/empty = follow every page)
FACTCHECK_API_KEY=
FACTCHECK_QUERIES=

# Scrutins-archive crawler (`make scrutins-crawl`): conditionally downloads the
# Assemblee Nationale open-data Scrutins.json.zip bulk archive (Etalab Licence
# Ouverte 2.0, attribution "Assemblee nationale - data.assemblee-nationale.fr";
# programmatic bulk download is permitted), discovers each recorded scrutin, and
# publishes one self-contained job to its own queue (RABBITMQ_SCRUTINS_QUEUE,
# default scrutins.votes); the scrutinsworker fleet parses and upserts them into
# the voting store. A persisted ETag/Last-Modified marker makes the download a
# conditional GET, so an unchanged archive returns 304 and the run does no
# redundant work. No API key (public open data). All optional (defaults shown):
#   SCRUTINS_LEGISLATURE       AN legislature number, interpolated into the URL (default 17)
#   SCRUTINS_MARKER_PATH       where the conditional-GET marker persists between runs
#                              (default /state/scrutins-marker.json; empty disables the skip)
#   SCRUTINS_WORKER_CONCURRENCY  scrutins parsed/upserted in parallel per replica (default 4)
#   SCRUTINS_WORKER_MAX_ATTEMPTS per-job delivery budget before a drop (default 5)
SCRUTINS_LEGISLATURE=
SCRUTINS_MARKER_PATH=

# Ingestion-fleet scheduler (the always-on `scheduler` compose service). Runs each
# enabled source's producer on its own cron cadence with no manual command - the
# Wikipedia, fact-check-archive, and scrutins crawls publish into their queues for
# the worker fleet to drain, an overlapping tick of a source whose previous run is
# still in flight is skipped, and every run posts the standard start/finish/failure
# Slack alerts (SLACK_WEBHOOK_URL below). Each source reads the same producer config
# its standalone crawler does (CRAWL_*, FACTCHECK_*, SCRUTINS_* above), so an enabled
# source needs those set. Every source defaults DISABLED so a plain `docker compose
# up` runs an idle scheduler and never starts paid ingestion - opt a source in with
# its *_ENABLED=true. All optional (defaults shown); a malformed cron spec fails the
# scheduler fast at startup:
#   SCHEDULE_WIKIPEDIA_ENABLED   run the Wikipedia crawl on a schedule (default false)
#   SCHEDULE_WIKIPEDIA_CRON      its 5-field cron spec (default "0 3 * * *", 03:00 daily)
#   SCHEDULE_FACTCHECK_ENABLED   run the fact-check-archive crawl (default false)
#   SCHEDULE_FACTCHECK_CRON      its cron spec (default "0 4 * * *", 04:00 daily)
#   SCHEDULE_SCRUTINS_ENABLED    run the scrutins crawl (default false)
#   SCHEDULE_SCRUTINS_CRON       its cron spec (default "30 4 * * *", 04:30 daily)
#   SCHEDULE_JITTER              random per-run delay spreading concurrent sources,
#                                Go duration, capped at 1h (default 30s)
SCHEDULE_WIKIPEDIA_ENABLED=
SCHEDULE_WIKIPEDIA_CRON=
SCHEDULE_FACTCHECK_ENABLED=
SCHEDULE_FACTCHECK_CRON=
SCHEDULE_SCRUTINS_ENABLED=
SCHEDULE_SCRUTINS_CRON=
SCHEDULE_JITTER=

# Media bytes for the curated sample video gallery (`make seed` / `make
# seed-videos`). Empty falls back to a public test clip (BigBuckBunny). The
# clip is fetched once and cached under stack/backend/seed/media-cache/
# (gitignored, reused across reseeds); an unreachable host with no cache seeds
# the sample records without media instead of failing. Sample videos stream
# live through the AssemblyAI pipeline when played, so any clip produces
# fact-checks; set this to a clip whose claims overlap the seeded corpus for
# the most interesting verdicts.
SAMPLE_VIDEO_URL=

# Operator login. `make bootstrap` fills the three values below for you (it
# prompts for the email and password, hashes the password, and generates the
# session secret); set them by hand only if you are not using bootstrap.

# Operator login email.
AUTH_EMAIL=

# Encoded argon2id hash of the operator password - never the password itself.
# Generate it with: printf '%s' "your-password" | go run ./cmd/genhash
# (run from stack/backend). Single-quote the value so the $ signs in the hash
# are not expanded by docker-compose:
# AUTH_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$...'
AUTH_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$shBQcmQC9qrZBGi0S55dZw$8FQY60gGln/W4hIs42tz7yeJ2WEzZFNOCbIlhNdx0k4'

# Session-signing secret, at least 32 bytes.
# Generate it with: openssl rand -hex 32
# Rotating it (plus a backend restart) invalidates every outstanding session.
SESSION_SECRET=

# Slack incoming-webhook URL for the daily development digest (`make digest`).
# Provisioned secret; treat it as one. Absent -> `make digest` errors; the
# terminal report (`/report` / `--terminal`) and `--dry-run` work without it.
SLACK_DIGEST_WEBHOOK_URL=

# Slack incoming-webhook URL for ingestion-fleet run alerts (crawl start, finish
# summary, and failures). Provisioned secret; treat it as one. Absent -> the
# crawl notifier is a silent no-op, so local ingestion runs are unaffected.
SLACK_WEBHOOK_URL=

# Linear personal API key. Enables the digest's Linear activity and blocker
# sections; absent -> those sections show a note. Read-only usage.
LINEAR_API_KEY=

# GitHub token for the digest's open-PR section. Optional: the public repo works
# without it, but a token raises the rate limit.
GITHUB_TOKEN=

# API key for the digest's per-card "what was implemented" summaries. Honors the
# global LLM_PROVIDER: under the default (deepseek) the key is DEEPSEEK_API_KEY;
# under LLM_PROVIDER=gemini it is GEMINI_API_KEY; under LLM_PROVIDER=anthropic it
# is this var. Optional either way: absent -> shipped cards fall back to their
# Linear titles, so the digest still works fully. DIGEST_SUMMARY_MODEL overrides
# the model (the selected provider's default otherwise).
DIGEST_SUMMARY_API_KEY=
DIGEST_SUMMARY_MODEL=
