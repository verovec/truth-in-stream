# Copy to .env (gitignored) and fill in. docker-compose interpolates these
# into the service environments. The local dataset seeds fully offline from a
# committed embedding cache, so none of these keys are needed just to bring the
# stack up with `make up` and play the demo; they only matter for live work.

# ElevenLabs API key for Scribe v2 speech-to-text. Needed only to transcribe a
# real (non-seeded) video; the demo results are precomputed fixtures.
TRANSCRIPTION_API_KEY=

# Voyage AI API key for embeddings. NOT needed for seeding (vectors come from the
# committed cache). Only needed to embed live query/segment text or to run
# `make refresh-embeddings` after editing a fixture's text.
EMBEDDING_API_KEY=

# Operator login email.
AUTH_EMAIL=

# Encoded argon2id hash of the operator password - never the password itself.
# Generate it with: printf '%s' "your-password" | go run ./cmd/genhash
# (run from stack/backend). Single-quote the value so the $ signs in the hash
# are not expanded by docker-compose:
# AUTH_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$...'
AUTH_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$shBQcmQC9qrZBGi0S55dZw$8FQY60gGln/W4hIs42tz7yeJ2WEzZFNOCbIlhNdx0k4'

# Session-signing secret, at least 32 bytes.
# Generate it with: openssl rand -hex 32
# Rotating it (plus a backend restart) invalidates every outstanding session.
SESSION_SECRET=
