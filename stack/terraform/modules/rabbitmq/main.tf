locals {
  name = "${var.project}-${var.environment}-rabbitmq"

  # instances[0].endpoints[0] is the broker's AMQPS endpoint (amqps://host:5671).
  # Inject the credentials to produce a ready-to-use connection URL, mirroring how
  # the RDS module ships a single DATABASE_URL secret.
  amqp_endpoint = aws_mq_broker.main.instances[0].endpoints[0]
  broker_host   = replace(local.amqp_endpoint, "amqps://", "")
  broker_url    = "amqps://${var.username}:${random_password.broker.result}@${local.broker_host}/"
}

# No special characters: the password is embedded in a connection URL and must
# stay URL-safe without encoding. 32 alphanumeric characters clears the Amazon MQ
# RabbitMQ minimum (12) comfortably.
resource "random_password" "broker" {
  length  = 32
  special = false
}

resource "aws_security_group" "broker" {
  name        = local.name
  description = "Amazon MQ RabbitMQ; ingress only from the application security groups"
  vpc_id      = var.vpc_id

  # Data plane only: the producer and worker reach the broker over AMQPS. The
  # management console (a human operator surface) is intentionally not opened to
  # the application security groups; reach it from a bastion or VPN if needed.
  ingress {
    description     = "AMQPS from application"
    from_port       = 5671
    to_port         = 5671
    protocol        = "tcp"
    security_groups = var.allowed_security_group_ids
  }

  # Management API over HTTPS, opened only to explicitly granted pollers (the
  # metrics lambda), never to the application security groups. Default-off: an
  # empty management_allowed_security_group_ids adds no rule. Inline (vs. a
  # standalone rule) because this SG already declares inline ingress, which a
  # separate aws_*_security_group_rule would conflict with.
  dynamic "ingress" {
    for_each = length(var.management_allowed_security_group_ids) > 0 ? [1] : []
    content {
      description     = "RabbitMQ management API (HTTPS) from allowed pollers"
      from_port       = 443
      to_port         = 443
      protocol        = "tcp"
      security_groups = var.management_allowed_security_group_ids
    }
  }

  egress {
    description = "All outbound"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Name = local.name }
}

resource "aws_mq_broker" "main" {
  broker_name = "${var.project}-${var.environment}"

  engine_type        = "RabbitMQ"
  engine_version     = var.engine_version
  host_instance_type = var.host_instance_type
  deployment_mode    = var.deployment_mode

  publicly_accessible = false
  subnet_ids          = var.subnet_ids
  security_groups     = [aws_security_group.broker.id]

  auto_minor_version_upgrade = true

  # Generated password; the value reaches the application only through the
  # connection-URL secret below, never as a Terraform variable input.
  user {
    username = var.username
    password = random_password.broker.result
  }

  logs {
    general = true
  }

  # Weekly maintenance reboot, kept off the daily producer cron slots so a
  # scheduled ingestion run never hits a rebooting broker (see the variable docs).
  maintenance_window_start_time {
    day_of_week = var.maintenance_window_day
    time_of_day = var.maintenance_window_time
    time_zone   = var.maintenance_window_time_zone
  }
}

# Ready-to-use AMQP connection URL so the producer and worker consume a single
# RABBITMQ_URL secret, exactly as the services consume the RDS DSN secret.
resource "aws_secretsmanager_secret" "url" {
  name                    = "${var.project}/${var.environment}/rabbitmq/url"
  description             = "Full AMQP connection URL for the embedding-job queue (generated by Terraform)."
  recovery_window_in_days = var.secret_recovery_window_days
}

resource "aws_secretsmanager_secret_version" "url" {
  secret_id     = aws_secretsmanager_secret.url.id
  secret_string = local.broker_url
}
