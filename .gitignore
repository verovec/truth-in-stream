# understand-anything local artifacts (knowledge graph, scans, tmp)
**/.understand-anything/

# Parallel-card worktrees
.claude/worktrees/
.worktrees/

# IDE and OS
.DS_Store
*.swp

# MCP config (local secrets)
.cursor/mcp.json
.mcp.json.local

# Claude local settings
.claude/settings.local.json

# Dependencies
node_modules/
.venv/
__pycache__/

# Database backups (local pg_dump archives; the durable copy lives in S3)
/backups/

# Env files (secrets)
.env
.env.*
!.env.example

# Account guard target ids (public repo: real AWS account ids stay local).
# The committed template is deploy/targets.example.json.
deploy/targets.json

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# Terraform variable values may carry real account ids; keep them local.
# The committed template is *.tfvars.example. The dev/prod roots track a
# non-sensitive selector tfvars (aws_region + environment only, no ids/secrets)
# that CI auto-loads for plan; those two are the only tracked *.tfvars.
*.tfvars
*.tfvars.json
!stack/terraform/dev/terraform.tfvars
!stack/terraform/prod/terraform.tfvars


note.txt
